#=============================================================================
# backup-v2.sh 配置文件
#
# 部署位置建议：/etc/backup.env
# 权限必须收紧：chmod 600 /etc/backup.env   （里面有数据库密码和加密密钥）
# 属主：chown root:root /etc/backup.env
#
# 这个文件不要进 git。密码请另外在密码管理器里离线存一份。
#=============================================================================

#-----------------------------------------------------------------------------
# 基本路径
#-----------------------------------------------------------------------------
LOCALDIR="/opt/backups"
TEMPDIR="/opt/backups/temp"
LOGFILE="/opt/backups/backup.log"
LOCKFILE="/var/run/backup.lock"

#-----------------------------------------------------------------------------
# 保留策略（本地与云端解耦，这是原版最大的缺陷之一）
#-----------------------------------------------------------------------------
# 本地留几天：省磁盘，够应急回滚就行
KEEP_LOCAL_DAYS=7
# 云端留几天：这才是保命的那份，建议 90 天以上
KEEP_REMOTE_DAYS=90

#-----------------------------------------------------------------------------
# 数据库
#-----------------------------------------------------------------------------
# none         不备份数据库
# mysql        宿主机上直装 MySQL/MariaDB
# docker-mysql 数据库跑在 Docker 容器里
DB_TYPE="none"

MYSQL_ROOT_USER="root"
MYSQL_ROOT_PASSWORD=""

# 留空 = 备份全部数据库；否则列出库名
MYSQL_DATABASE_NAMES=()

# DB_TYPE=docker-mysql 时必填，填容器名
MYSQL_DOCKER_CONTAINER=""

#-----------------------------------------------------------------------------
# 要备份的文件与目录
#-----------------------------------------------------------------------------
# 注意：这些内容会以绝对路径打进包里，恢复时解压即回原位
# 建议只放"不可再生"的东西：配置、上传文件、证书
# 代码和依赖不要放进来，那些应该从 git 和镜像仓库恢复
BACKUP_PATHS=(
    "/opt/app/data"
    "/etc/nginx"
)

#-----------------------------------------------------------------------------
# 加密
#-----------------------------------------------------------------------------
# 强烈建议保持 true。网盘会扫描内容，且不能假设网盘是可信的。
ENCRYPT=true

# 【重要】这个密码请同时在 VPS 之外的密码管理器里存一份。
# 机器丢了而密码只存在机器上 = 网盘上那份备份永远解不开。
# 恢复命令：
#   openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -md sha256 \
#     -in 备份文件.tgz.enc -out 恢复.tgz -pass pass:你的密码 -d
BACKUP_PASSWORD=""

#-----------------------------------------------------------------------------
# 上传到 Google Drive（rclone）
#-----------------------------------------------------------------------------
RCLONE_ENABLED=true

# rclone 的 remote 名称，对应 rclone config 里配的那个，比如 gdrive
RCLONE_REMOTE="gdrive"

# remote 下的目录。建议按主机名分开，多台机器共用一个网盘时不会串
RCLONE_FOLDER="backup/$(hostname -s)"

# 限速。白天限流、夜里放开，避免影响业务带宽
# 格式："08:00,8M 23:00,off" 表示 8 点到 23 点限 8MB/s，其余不限
RCLONE_BWLIMIT="off"

# Google Drive 默认只有约 10 次 API 调用/秒，留点余量
RCLONE_TPSLIMIT=8
RCLONE_TRANSFERS=4

#-----------------------------------------------------------------------------
# 通知
#-----------------------------------------------------------------------------
# 成功和失败都会发。成功那条是"心跳"：
#   收到成功 = 跑完了 | 收到失败 = 出事了 | 什么都没收到 = 出事了（最坏的一种）
NOTIFY_ENABLED=true

# smtp      用标准 SMTP 发邮件（curl 自带支持，VPS 上零安装）
# agentmail 调 AgentMail REST API
# ntfy      推送到 ntfy
# webhook   POST 到自建接收端（服务端需自备）
# notion    写成 Notion 数据库的一行（不占自己机器，人机都能读）
# custom    自己写一条命令
NOTIFY_TYPE="notion"

# 邮件主题与正文模板。可用变量：
#   {{HOSTNAME}} {{STATUS}} {{STATUS_CN}} {{DATE}}
#   {{DB_STATUS}} {{TAR_SIZE}} {{ENC_STATUS}} {{UPLOAD_STATUS}}
#   {{REMOTE}} {{DURATION}} {{FILE}} {{ERROR}} {{NOTE}}
NOTIFY_SUBJECT="[备份] {{STATUS_CN}} - {{HOSTNAME}}"

NOTIFY_BODY="主机: {{HOSTNAME}}
状态: {{STATUS_CN}}
时间: {{DATE}}
耗时: {{DURATION}} 秒
文件: {{FILE}}
大小: {{TAR_SIZE}}
数据库: {{DB_STATUS}}
加密: {{ENC_STATUS}}
上传: {{UPLOAD_STATUS}}
远端: {{REMOTE}}
失败原因: {{ERROR}}
备注: {{NOTE}}

-- 由 backup-v2.sh 自动发送"

# 附加备注，会填进 {{NOTE}}
NOTIFY_NOTE=""

#--- 下面是 smtp 模式的配置 -----------------------------------------------

# QQ 邮箱：smtp.qq.com / 465 / ssl，密码填"授权码"不是登录密码
# 163 邮箱：smtp.163.com / 465 / ssl，同样用授权码
# Gmail：smtp.gmail.com / 587 / starttls，需要应用专用密码
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_TLS="ssl"          # ssl（465端口）或 starttls（587端口）
SMTP_USER=""            # 发信邮箱，如 you@qq.com
SMTP_PASS=""            # 授权码
SMTP_FROM=""            # 留空则用 SMTP_USER
SMTP_TO=""              # 收件方

#--- 下面是 agentmail 模式的配置（NOTIFY_TYPE=agentmail 时才需要）---------

# 从 AgentMail 控制台取的 API key（以 am_ 开头）
AGENTMAIL_KEY=""
# 收件邮箱
AGENTMAIL_TO=""
# 发信用的 inbox
AGENTMAIL_INBOX=""
# API 基地址，一般不用改
AGENTMAIL_BASE="https://api.agentmail.to"

#--- 下面是 webhook 模式的配置（NOTIFY_TYPE=webhook 时才需要）--------------
#
# 指向你自己的接收端。脚本会把结构化字段和渲染好的文本一起 POST 过去。
#
# NOTIFY_WEBHOOK_TOKEN 是服务端约定的写入 token，填错会被拒绝，
# 脚本会明确报错（curl -f，HTTP 非 2xx 即视为发送失败）。
# 服务端最小只需两个接口：POST /api/report?token=X 收下 JSON，GET /health 返回存活。

NOTIFY_WEBHOOK_URL="http://127.0.0.1:8899"
NOTIFY_WEBHOOK_TOKEN=""

# 上报时跳过系统代理。默认 '*' 表示不走任何代理。
# 踩过的坑：机器上只要存在 HTTP_PROXY 环境变量，curl 会把发往 127.0.0.1
# 的上报也丢给代理，代理返回 502，表现成"通知失败"但请求压根没到服务端。
# 确实需要经代理访问接收端时，把这里改成具体地址或留空。
NOTIFY_NO_PROXY="*"

#--- 下面是 notion 模式的配置（NOTIFY_TYPE=notion 时才需要）-----------------
#
# 三个东西：token、目标 id、以及「在 Notion 界面里把目标连接给这个
# integration」。第三件事最容易漏——新建的 integration 权限是空的，
# 不连接就永远是 404 或 object_not_found，报错还看不出原因。
#
# 怎么拿这三样，见 notify-notion-setup.md

# 从 notion.so/my-integrations 新建 internal integration 后，在 Secrets 里复制
# 形如 ntn_xxxxx 或 secret_xxxxx
NOTION_TOKEN=""

# database（推荐）或 page
#   database：数据库里多一行，有表格视图，能筛选「只看失败」，能按时间排序
#   page    ：往一个页面里追加流水，不需要建列，配置最少，但没法筛选
NOTION_TARGET="database"

# 目标 ID：
#   database 模式 —— 打开数据库页面，复制链接里 ?v= 之前那段 32 位字符串
#   page 模式     —— 打开页面，复制链接最后那段 32 位字符串
# 链接里带不带横杠都行，Notion 两种都能识别
NOTION_TARGET_ID=""

# API 版本，固定住别动。Notion 调整过数据库的寻址方式，
# 不 pin 版本的话，上游一改你的脚本就可能突然不工作。
NOTION_VERSION="2022-06-28"

# 下面三个是数据库的**列名**，必须和你在 Notion 里看到的完全一致
# （含大小写和空格）。Notion 是按列名寻址的：
#   列名对不上        -> 直接 400，Notion 会告诉你哪个列不存在
#   建好后改列名      -> 脚本静默失效，日志看不出来
# 中文界面新建的数据库，标题列默认叫「名称」；英文界面叫「Name」。
# 页面模式（NOTION_TARGET=page）不需要这三项。
NOTION_TITLE_PROP="名称"
NOTION_STATUS_PROP="状态"
NOTION_DATE_PROP="时间"

# 「状态」这一列的属性类型，必须和 Notion 里实际的一致：
#   status    Notion 原生状态列（中文界面的「状态」默认就是这种）
#             注意：它的选项不能即写即建，列里必须先有「成功」「失败」这两个选项
#   select    单选列，选项不存在时 Notion 会自动创建，最省事
#   rich_text 纯文本列，什么值都收，但没法做筛选和分组
# 填错时 Notion 会报 "xxx is expected to be yyy"，照报错改即可
NOTION_STATUS_TYPE="status"

#--- 下面是 ntfy 模式的配置（NOTIFY_TYPE=ntfy 时才需要）--------------------

# 建议用一长串随机字符做 topic 名，默认公开可读
NTFY_URL="https://ntfy.sh/change-me-to-a-long-random-topic"

#--- 下面是 custom 模式的配置（NOTIFY_TYPE=custom 时才需要）----------------

# 内容通过环境变量 NOTIFY_SUBJECT_RENDERED 和 NOTIFY_BODY_RENDERED 传入
NOTIFY_CUSTOM_CMD=''
